{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catenary",
  "version": "0.60.0",
  "identifier": "net.zebrine.catenary",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:14041",
    "beforeBuildCommand": "",
    "frontendDist": "http://localhost:14041"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Catenary",
        "url": "http://localhost:14041",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/catenary-backend"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}